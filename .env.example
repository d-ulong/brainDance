# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://braindance:braindance@localhost:5432/braindance

# Session (generate with: openssl rand -base64 32)
SESSION_SECRET=replace-with-at-least-32-characters-secret

# Optional: set true to skip DB integration tests locally
SKIP_DB_TESTS=false

# Private export/deletion artifact root (absolute path; local/dev may use <repo>/.braindance-artifacts)
BRAIN_DANCE_ARTIFACT_ROOT=
